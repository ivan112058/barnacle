{
  "name": "barnacle",
  "version": "0.1.0",
  "private": true,
  "description": "A semantic-first Neubrutalism UI library. Zero runtime dependencies.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/js/base.test.mjs tests/js/tabs.test.mjs tests/js/toast.test.mjs tests/js/dropdown.test.mjs tests/js/taginput.test.mjs",
    "test:browser": "node --test --test-force-exit --test-concurrency=2 tests/browser/",
    "test:browser:mutations": "node tests/browser/mutation-sweep.mjs",
    "i18n": "node scripts/i18n-zh.mjs",
    "i18n:check": "node scripts/i18n-zh.mjs --check",
    "verify": "node scripts/verify.mjs",
    "verify:theme": "node scripts/verify-theme.mjs",
    "verify:i18n": "node scripts/verify-i18n.mjs",
    "verify:site": "node scripts/verify-site.mjs",
    "verify:site-shell": "node scripts/verify-site-shell.mjs",
    "verify:deploy": "node scripts/verify-deploy.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "verify:demo": "node scripts/verify-demo.mjs",
    "verify:base": "node scripts/verify-base.mjs",
    "verify:button": "node scripts/verify-button.mjs",
    "verify:progress": "node scripts/verify-progress.mjs",
    "verify:toast": "node scripts/verify-toast.mjs",
    "verify:tabs": "node scripts/verify-tabs.mjs",
    "verify:dropdown": "node scripts/verify-dropdown.mjs",
    "verify:taginput": "node scripts/verify-taginput.mjs",
    "verify:interaction": "node scripts/verify-interaction.mjs",
    "verify:static": "node scripts/verify-static.mjs",
    "verify:table": "node scripts/verify-table.mjs",
    "verify:switch": "node scripts/verify-switch.mjs",
    "verify:form": "node scripts/verify-form.mjs",
    "verify:dialog": "node scripts/verify-dialog.mjs",
    "verify:accordion": "node scripts/verify-accordion.mjs",
    "verify:layout": "node scripts/verify-layout.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "esbuild": "0.28.2",
    "playwright-core": "1.64.1"
  }
}
